# Copie para .env (na raiz do projeto) e preencha. NUNCA suba o .env para o GitHub.

# Provedor de IA de visão: gemini (padrão, usado se a variável faltar ou estiver vazia) ou groq.
LUCRAFOOD_PROVEDOR=gemini

# Gemini (chave em aistudio.google.com > Get API key)
GEMINI_API_KEY=
GEMINI_MODELO_VISAO=gemini-3.5-flash-lite

# Groq (alternativa; plano gratuito: ~1000 tokens de saída/min, corta cardápios grandes)
GROQ_API_KEY=
GROQ_MODELO_VISAO=qwen/qwen3.8-27b

# Opcionais: sobrescrevem os padrões do provedor escolhido (ver cardapio/ia/cliente.py)
# LUCRAFOOD_MAX_TOKENS=900            # teto de tokens de saída por chamada
# LUCRAFOOD_LIMITE_SAIDA_MIN=1000     # tokens de saída/min (0 = sem limitador)
# LUCRAFOOD_LIMITE_TOKENS_MIN=8000    # aviso se uma chamada passar disso (0 = sem aviso)

DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=1
